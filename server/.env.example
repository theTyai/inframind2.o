# ─── OpenRouter AI ────────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Any model available to your account, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=InfraMind
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_TOKENS=12000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/inframind
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/inframind
MONGODB_URI=mongodb://127.0.0.1:27017/inframind

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_48_chars
# Access token lifetime (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
